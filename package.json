{
  "name": "@soulverse/ssw-sera",
  "version": "0.1.0",
  "private": true,
  "description": "Soul Super Wallet SERA implementation workspace",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap-control-path.mjs",
    "verify:scaffold": "node scripts/verify-scaffold.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run verify:scaffold && npm run verify:contracts && npm test"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
