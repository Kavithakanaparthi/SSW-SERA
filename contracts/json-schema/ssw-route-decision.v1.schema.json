{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soulverse.world/ssw/json-schema/ssw-route-decision.v1.schema.json",
  "title": "SSW Route Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "route_decision_id",
    "route_request_id",
    "holder_did",
    "sera_agent_did",
    "status",
    "recommended",
    "alternatives",
    "excluded",
    "basis",
    "material_change",
    "requires_fresh_review",
    "authority_effect",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "ssw.route-decision.v1"
    },
    "route_decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "route_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "holder_did": {
      "type": "string",
      "pattern": "^did:soul:[a-z0-9._:-]+$"
    },
    "sera_agent_did": {
      "type": "string",
      "pattern": "^did:soul:agent:[a-z0-9._:-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "RECOMMENDED",
        "NO_ELIGIBLE_ROUTE"
      ]
    },
    "recommended": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route_id",
            "chain_id",
            "balance_atomic",
            "recipient_compatible",
            "fee_atomic",
            "estimated_settlement_seconds",
            "bridge_required",
            "risk_level",
            "chain_available",
            "asset_verified",
            "provider_ref"
          ],
          "properties": {
            "route_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "chain_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "balance_atomic": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "recipient_compatible": {
              "type": "boolean"
            },
            "fee_atomic": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "estimated_settlement_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 604800
            },
            "bridge_required": {
              "type": "boolean"
            },
            "risk_level": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "BLOCKED"
              ]
            },
            "chain_available": {
              "type": "boolean"
            },
            "asset_verified": {
              "type": "boolean"
            },
            "provider_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "alternatives": {
      "type": "array",
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "chain_id",
          "balance_atomic",
          "recipient_compatible",
          "fee_atomic",
          "estimated_settlement_seconds",
          "bridge_required",
          "risk_level",
          "chain_available",
          "asset_verified",
          "provider_ref"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "chain_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "balance_atomic": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "recipient_compatible": {
            "type": "boolean"
          },
          "fee_atomic": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "estimated_settlement_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 604800
          },
          "bridge_required": {
            "type": "boolean"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "BLOCKED"
            ]
          },
          "chain_available": {
            "type": "boolean"
          },
          "asset_verified": {
            "type": "boolean"
          },
          "provider_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "reason_codes"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        }
      }
    },
    "basis": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "material_change": {
      "type": "boolean"
    },
    "requires_fresh_review": {
      "type": "boolean"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
