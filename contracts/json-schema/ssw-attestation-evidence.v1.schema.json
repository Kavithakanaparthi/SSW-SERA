{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-attestation-evidence.v1.schema.json",
  "title":"SSW Device and Runtime Attestation Evidence v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","attestation_id","profile","provider","subject",
    "challenge","status","issued_at","expires_at","claims","integrity"
  ],
  "properties":{
    "schema":{"const":"ssw.attestation-evidence.v1"},
    "attestation_id":{"type":"string","format":"uuid"},
    "profile":{
      "type":"string",
      "enum":[
        "APPLE_APP_ATTEST",
        "ANDROID_PLAY_INTEGRITY",
        "WEARABLE_PAIRED_PROFILE",
        "CLOUD_WORKLOAD_ATTESTATION",
        "RECOVERY_LIMITED_PROFILE"
      ]
    },
    "provider":{"type":"string","minLength":1},
    "subject":{
      "type":"object",
      "additionalProperties":false,
      "required":["subject_type","device_id","runtime_id"],
      "properties":{
        "subject_type":{"type":"string","enum":["DEVICE","RUNTIME","DEVICE_AND_RUNTIME","CLOUD_RUNTIME"]},
        "device_id":{"type":["string","null"],"pattern":"^device:[A-Za-z0-9._:-]+$"},
        "runtime_id":{"type":"string","pattern":"^sera-runtime:[A-Za-z0-9._:-]+$"}
      }
    },
    "challenge":{
      "type":"object",
      "additionalProperties":false,
      "required":["challenge_id","nonce_hash","audience","issued_at","expires_at"],
      "properties":{
        "challenge_id":{"type":"string","format":"uuid"},
        "nonce_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "audience":{"type":"string","minLength":1},
        "issued_at":{"type":"string","format":"date-time"},
        "expires_at":{"type":"string","format":"date-time"}
      }
    },
    "status":{"type":"string","enum":["PASS","FAIL","UNAVAILABLE","EXPIRED","UNSUPPORTED"]},
    "issued_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "claims":{
      "type":"object",
      "additionalProperties":false,
      "required":["app_identity","build_class","runtime_key_bound","production_environment"],
      "properties":{
        "app_identity":{"type":["string","null"]},
        "build_identity":{"type":["string","null"]},
        "build_class":{"type":"string","enum":["PRODUCTION","DEVELOPMENT","TEST","DEBUG","UNKNOWN"]},
        "runtime_key_bound":{"type":"boolean"},
        "production_environment":{"type":"boolean"},
        "secure_hardware":{"type":["boolean","null"]},
        "device_integrity":{"type":["string","null"]},
        "workload_identity":{"type":["string","null"]},
        "node_identity":{"type":["string","null"]},
        "platform_claims_ref":{"type":["string","null"]}
      }
    },
    "integrity":{
      "type":"object",
      "additionalProperties":false,
      "required":["evidence_hash","verifier_ref"],
      "properties":{
        "evidence_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "verifier_ref":{"type":"string","minLength":1},
        "signature_ref":{"type":["string","null"]}
      }
    },
    "reason_codes":{
      "type":"array",
      "uniqueItems":true,
      "items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"}
    }
  }
}
