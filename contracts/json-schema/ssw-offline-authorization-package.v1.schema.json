{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-offline-authorization-package.v1.schema.json",
  "title":"SSW Offline Authorization Package v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","oap_id","version","holder_did","sera_agent_did",
    "issued_at","expires_at","authority","risk","device_policy",
    "runtime_policy","scope","limits","freshness","offline_basis",
    "replay","usage","reconciliation","integrity"
  ],
  "properties":{
    "schema":{"const":"ssw.offline-authorization-package.v1"},
    "oap_id":{"type":"string","format":"uuid"},
    "version":{"type":"integer","minimum":1},
    "holder_did":{"type":"string","pattern":"^did:soul:[a-z0-9._:-]+$"},
    "sera_agent_did":{"type":"string","pattern":"^did:soul:agent:[a-z0-9._:-]+$"},
    "issued_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "authority":{
      "type":"object","additionalProperties":false,
      "required":["allowed_classes","mandate_id","approval_model"],
      "properties":{
        "allowed_classes":{
          "type":"array",
          "minItems":1,
          "uniqueItems":true,
          "items":{"type":"string","enum":["A1","A2","A3","A4"]}
        },
        "mandate_id":{"type":["string","null"],"format":"uuid"},
        "approval_model":{"type":"string","enum":["NONE","EXPLICIT_PER_ACTION","PREEXISTING_APPROVAL_ONLY","MANDATE_GOVERNED"]}
      }
    },
    "risk":{
      "type":"object","additionalProperties":false,
      "required":["max_risk_class"],
      "properties":{
        "max_risk_class":{"type":"string","enum":["R0","R1","R2","R3","R4"]}
      }
    },
    "device_policy":{
      "type":"object","additionalProperties":false,
      "required":["allowed_device_ids","minimum_state","attestation_max_age_seconds"],
      "properties":{
        "allowed_device_ids":{
          "type":"array","minItems":1,"uniqueItems":true,
          "items":{"type":"string","pattern":"^device:[A-Za-z0-9._:-]+$"}
        },
        "minimum_state":{"type":"string","enum":["ATTESTED","TRUSTED","LIMITED"]},
        "attestation_max_age_seconds":{"type":"integer","minimum":1}
      }
    },
    "runtime_policy":{
      "type":"object","additionalProperties":false,
      "required":["allowed_runtime_ids","allowed_runtime_classes"],
      "properties":{
        "allowed_runtime_ids":{
          "type":"array","uniqueItems":true,
          "items":{"type":"string","pattern":"^sera-runtime:[A-Za-z0-9._:-]+$"}
        },
        "allowed_runtime_classes":{
          "type":"array","uniqueItems":true,
          "items":{"type":"string","enum":["PRIMARY_PHONE","SECONDARY_PHONE","TABLET","DESKTOP","WEARABLE"]}
        }
      }
    },
    "scope":{
      "type":"object","additionalProperties":false,
      "required":["action_types","assets","chains","counterparties"],
      "properties":{
        "action_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "assets":{"type":"array","items":{"type":"object"}},
        "chains":{"type":"array","items":{"type":"object"}},
        "counterparties":{"type":"array","items":{"type":"object"}}
      }
    },
    "limits":{
      "type":"object","additionalProperties":false,
      "required":["per_action","cumulative","max_actions"],
      "properties":{
        "per_action":{
          "type":"object","additionalProperties":false,
          "required":["atomic","decimals"],
          "properties":{
            "atomic":{"type":"string","pattern":"^[0-9]+$"},
            "decimals":{"type":"integer","minimum":0,"maximum":255}
          }
        },
        "cumulative":{
          "type":"object","additionalProperties":false,
          "required":["atomic","decimals","window_seconds"],
          "properties":{
            "atomic":{"type":"string","pattern":"^[0-9]+$"},
            "decimals":{"type":"integer","minimum":0,"maximum":255},
            "window_seconds":{"type":"integer","minimum":1}
          }
        },
        "max_actions":{"type":"integer","minimum":1}
      }
    },
    "freshness":{
      "type":"object","additionalProperties":false,
      "required":["policy_version","package_max_age_seconds"],
      "properties":{
        "policy_version":{"type":"string","minLength":1},
        "package_max_age_seconds":{"type":"integer","minimum":1},
        "mandate_evaluation_max_age_seconds":{"type":["integer","null"],"minimum":1},
        "cached_trust_max_age_seconds":{"type":["integer","null"],"minimum":1}
      }
    },
    "offline_basis":{
      "type":"string",
      "enum":["TRUST_PREAUTHORIZED_OFFLINE","REV_PREAUTHORIZED_OFFLINE","LOCAL_POLICY_ONLY"]
    },
    "replay":{
      "type":"object","additionalProperties":false,
      "required":["mode","counter_start","replay_domain"],
      "properties":{
        "mode":{"type":"string","enum":["MONOTONIC_COUNTER","ONE_TIME_TOKEN","ACTION_HASH_LEDGER"]},
        "counter_start":{"type":"integer","minimum":0},
        "replay_domain":{"type":"string","minLength":1}
      }
    },
    "usage":{
      "type":"object","additionalProperties":false,
      "required":["actions_used","cumulative_atomic_used","last_counter"],
      "properties":{
        "actions_used":{"type":"integer","minimum":0},
        "cumulative_atomic_used":{"type":"string","pattern":"^[0-9]+$"},
        "last_counter":{"type":"integer","minimum":0}
      }
    },
    "reconciliation":{
      "type":"object","additionalProperties":false,
      "required":["required","deadline_seconds","conflict_action"],
      "properties":{
        "required":{"const":true},
        "deadline_seconds":{"type":"integer","minimum":1},
        "conflict_action":{"type":"string","enum":["FREEZE_REMAINING_ALLOWANCE","SUSPEND_PACKAGE","ESCALATE_REVIEW"]}
      }
    },
    "integrity":{
      "type":"object","additionalProperties":false,
      "required":["package_hash","signature_ref","issuer_ref"],
      "properties":{
        "package_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "signature_ref":{"type":"string","minLength":1},
        "issuer_ref":{"type":"string","minLength":1}
      }
    }
  }
}
