{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-trust-protocol-request.v1.schema.json",
 "title":"SSW Trust Protocol Request v1",
 "type":"object","additionalProperties":false,
 "required":["schema","request_id","action_id","action_version","material_terms_hash","principal","runtime","authority","risk","policy","context_refs","issued_at","expires_at"],
 "properties":{
  "schema":{"const":"ssw.trust-protocol-request.v1"},
  "request_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
  "action_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
  "action_version":{"type":"integer","minimum":1},
  "material_terms_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
  "principal":{"type":"object","additionalProperties":false,"required":["holder_did","sera_agent_did"],"properties":{
   "holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
   "sera_agent_did":{"$ref":"ssw-common.v1.schema.json#/$defs/seraAgentDid"}
  }},
  "runtime":{"type":"object","additionalProperties":false,"required":["device_id","sera_runtime_id","eligibility_decision_ref"],"properties":{
   "device_id":{"$ref":"ssw-common.v1.schema.json#/$defs/deviceId"},
   "sera_runtime_id":{"$ref":"ssw-common.v1.schema.json#/$defs/runtimeId"},
   "eligibility_decision_ref":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"}
  }},
  "authority":{"type":"object","additionalProperties":false,"required":["class","approval_ref","mandate_ref","mandate_evaluation_ref","mandate_terms_hash"],"properties":{
   "class":{"$ref":"ssw-common.v1.schema.json#/$defs/authorityClass"},
   "approval_ref":{"type":["string","null"]},
   "mandate_ref":{"type":["string","null"]},
   "mandate_evaluation_ref":{"type":["string","null"]},
   "mandate_terms_hash":{"anyOf":[{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},{"type":"null"}]}
  }},
  "risk":{"type":"object","additionalProperties":false,"required":["class","reason_codes"],"properties":{
   "class":{"$ref":"ssw-common.v1.schema.json#/$defs/riskClass"},
   "reason_codes":{"$ref":"ssw-common.v1.schema.json#/$defs/reasonCodes"}
  }},
  "policy":{"type":"object","additionalProperties":false,"required":["decision_ref","policy_ref","policy_version"],"properties":{
   "decision_ref":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
   "policy_ref":{"type":"string","minLength":1},
   "policy_version":{"type":"string","minLength":1}
  }},
  "context_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
  "issued_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
  "expires_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"}
 }
}