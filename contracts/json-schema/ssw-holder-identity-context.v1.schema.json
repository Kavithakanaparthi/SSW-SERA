{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-holder-identity-context.v1.schema.json",
  "title":"SSW Holder Identity Context v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","context_id","holder_did","sera_agent_did","wallet_context_ref",
    "soul_id","sera_governance","continuity","authority_effect",
    "observed_at","valid_until","created_at"
  ],
  "properties":{
    "schema":{"const":"ssw.holder-identity-context.v1"},
    "context_id":{"type":"string","format":"uuid"},
    "holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
    "sera_agent_did":{"$ref":"ssw-common.v1.schema.json#/$defs/seraAgentDid"},
    "wallet_context_ref":{"type":"string","minLength":1,"maxLength":512},
    "soul_id":{
      "type":"object","additionalProperties":false,
      "required":["status","did_document_ref","document_version","recovery_policy_ref","verification_method_refs","integrity_ref"],
      "properties":{
        "status":{"type":"string","enum":["ACTIVE","SUSPENDED"]},
        "did_document_ref":{"type":"string","minLength":1,"maxLength":2048},
        "document_version":{"type":"integer","minimum":1},
        "recovery_policy_ref":{"type":["string","null"],"maxLength":2048},
        "verification_method_refs":{"type":"array","maxItems":32,"items":{"type":"string","minLength":1,"maxLength":512},"uniqueItems":true},
        "integrity_ref":{"type":"string","minLength":1,"maxLength":2048}
      }
    },
    "sera_governance":{
      "type":"object","additionalProperties":false,
      "required":["status","binding_ref","binding_version"],
      "properties":{
        "status":{"const":"VERIFIED"},
        "binding_ref":{"type":"string","minLength":1,"maxLength":2048},
        "binding_version":{"type":"integer","minimum":1}
      }
    },
    "continuity":{
      "type":"object","additionalProperties":false,
      "required":["wallet_ownership_root","device_ownership_root","recovery_root","identity_continuity"],
      "properties":{
        "wallet_ownership_root":{"const":"SOUL_ID"},
        "device_ownership_root":{"const":false},
        "recovery_root":{"const":"SOUL_ID_SOULSCAN"},
        "identity_continuity":{"const":"ESTABLISHED"}
      }
    },
    "authority_effect":{"const":"NONE"},
    "observed_at":{"type":"string","format":"date-time"},
    "valid_until":{"type":"string","format":"date-time"},
    "created_at":{"type":"string","format":"date-time"}
  }
}