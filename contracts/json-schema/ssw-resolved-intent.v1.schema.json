{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-resolved-intent.v1.schema.json",
  "title":"SSW Resolved Intent v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","intent_id","correlation_id","intent_type","holder_did","sera_agent_did","sera_runtime_id","device_id","entities","context_refs","authority_requested","risk_preliminary","confidence","ambiguity","created_at","expires_at"],
  "properties":{
    "schema":{"const":"ssw.resolved-intent.v1"},
    "intent_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "correlation_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "intent_type":{"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
    "sera_agent_did":{"$ref":"ssw-common.v1.schema.json#/$defs/seraAgentDid"},
    "sera_runtime_id":{"$ref":"ssw-common.v1.schema.json#/$defs/runtimeId"},
    "device_id":{"$ref":"ssw-common.v1.schema.json#/$defs/deviceId"},
    "entities":{
      "type":"object",
      "additionalProperties":{
        "type":"object",
        "additionalProperties":false,
        "required":["value","resolution","source_ref"],
        "properties":{
          "value":{},
          "resolution":{"type":"string","enum":["EXPLICIT","RESOLVED","DEFAULTED_BY_POLICY","INFERRED_NON_MATERIAL","UNRESOLVED"]},
          "source_ref":{"type":["string","null"]}
        }
      }
    },
    "context_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "authority_requested":{"$ref":"ssw-common.v1.schema.json#/$defs/authorityClass"},
    "risk_preliminary":{"$ref":"ssw-common.v1.schema.json#/$defs/riskClass"},
    "confidence":{
      "type":"object","additionalProperties":false,
      "required":["overall","material_terms"],
      "properties":{
        "overall":{"type":"number","minimum":0,"maximum":1},
        "material_terms":{
          "type":"object",
          "additionalProperties":{"type":"number","minimum":0,"maximum":1}
        }
      }
    },
    "ambiguity":{
      "type":"object","additionalProperties":false,
      "required":["material","items"],
      "properties":{
        "material":{"type":"boolean"},
        "items":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"}}
      }
    },
    "created_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
    "expires_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"}
  }
}
