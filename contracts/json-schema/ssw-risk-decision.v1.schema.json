{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-risk-decision.v1.schema.json",
  "title":"SSW Risk Decision v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","decision_id","action_id","action_version","material_terms_hash","declared_class","baseline_class","final_class","status","reason_codes","evaluated_at"],
  "properties":{
    "schema":{"const":"ssw.risk-decision.v1"},
    "decision_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "action_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "action_version":{"type":"integer","minimum":1},
    "material_terms_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
    "declared_class":{"$ref":"ssw-common.v1.schema.json#/$defs/riskClass"},
    "baseline_class":{"$ref":"ssw-common.v1.schema.json#/$defs/riskClass"},
    "final_class":{"$ref":"ssw-common.v1.schema.json#/$defs/riskClass"},
    "status":{"type":"string","enum":["CLASSIFIED","RESTRICTED"]},
    "reason_codes":{"$ref":"ssw-common.v1.schema.json#/$defs/reasonCodes"},
    "evaluated_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"}
  }
}
