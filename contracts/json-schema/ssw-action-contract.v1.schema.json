{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-action-contract.v1.schema.json",
  "title":"SSW Action Contract v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","action_id","intent_id","correlation_id","action_type","version","created_at","expires_at","principal","authority","risk","material_terms","policy","trust","presentation","approval","execution","evidence"],
  "properties":{
    "schema":{"const":"ssw.action-contract.v1"},
    "action_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "intent_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "correlation_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "action_type":{"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "version":{"type":"integer","minimum":1},
    "created_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
    "expires_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
    "principal":{
      "type":"object","additionalProperties":false,
      "required":["holder_did","sera_agent_did","sera_runtime_id","device_id"],
      "properties":{
        "holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
        "sera_agent_did":{"$ref":"ssw-common.v1.schema.json#/$defs/seraAgentDid"},
        "sera_runtime_id":{"$ref":"ssw-common.v1.schema.json#/$defs/runtimeId"},
        "device_id":{"$ref":"ssw-common.v1.schema.json#/$defs/deviceId"}
      }
    },
    "authority":{
      "type":"object","additionalProperties":false,
      "required":["class","approval_required","mandate_id"],
      "properties":{
        "class":{"$ref":"ssw-common.v1.schema.json#/$defs/authorityClass"},
        "approval_required":{"type":"boolean"},
        "mandate_id":{"anyOf":[{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},{"type":"null"}]}
      }
    },
    "risk":{
      "type":"object","additionalProperties":false,
      "required":["class","reasons"],
      "properties":{
        "class":{"$ref":"ssw-common.v1.schema.json#/$defs/riskClass"},
        "reasons":{"$ref":"ssw-common.v1.schema.json#/$defs/reasonCodes"}
      }
    },
    "material_terms":{"type":"object"},
    "policy":{
      "type":"object","additionalProperties":false,
      "required":["policy_refs","device_eligible","runtime_eligible"],
      "properties":{
        "policy_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "device_eligible":{"type":"boolean"},
        "runtime_eligible":{"type":"boolean"}
      }
    },
    "trust":{
      "type":"object","additionalProperties":false,
      "required":["trust_protocol_required","trust_protocol_ref","rev_required","rev_ref"],
      "properties":{
        "trust_protocol_required":{"type":"boolean"},
        "trust_protocol_ref":{"type":["string","null"]},
        "rev_required":{"type":"boolean"},
        "rev_ref":{"type":["string","null"]}
      }
    },
    "presentation":{
      "type":"object","additionalProperties":false,
      "required":["concealed","reveal_required","authenticated_reveal_required","review_hash"],
      "properties":{
        "concealed":{"type":"boolean"},
        "reveal_required":{"type":"boolean"},
        "authenticated_reveal_required":{"type":"boolean"},
        "review_hash":{"anyOf":[{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},{"type":"null"}]}
      }
    },
    "approval":{
      "type":"object","additionalProperties":false,
      "required":["status","approval_id","approved_terms_hash"],
      "properties":{
        "status":{"$ref":"ssw-common.v1.schema.json#/$defs/approvalStatus"},
        "approval_id":{"anyOf":[{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},{"type":"null"}]},
        "approved_terms_hash":{"anyOf":[{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},{"type":"null"}]}
      }
    },
    "execution":{
      "type":"object","additionalProperties":false,
      "required":["idempotency_key","replay_token","status"],
      "properties":{
        "idempotency_key":{"type":"string","minLength":8},
        "replay_token":{"type":"string","minLength":8},
        "status":{"$ref":"ssw-common.v1.schema.json#/$defs/executionStatus"}
      }
    },
    "evidence":{
      "type":"object","additionalProperties":false,
      "required":["sael_correlation_id"],
      "properties":{
        "sael_correlation_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"}
      }
    }
  }
}
