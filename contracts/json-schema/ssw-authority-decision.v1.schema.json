{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-authority-decision.v1.schema.json",
  "title":"SSW Authority Decision v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","decision_id","action_id","action_version","material_terms_hash","authority_class","status","reason_codes","approval_ref","mandate_ref","evaluated_at"],
  "properties":{
    "schema":{"const":"ssw.authority-decision.v1"},
    "decision_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "action_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "action_version":{"type":"integer","minimum":1},
    "material_terms_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
    "authority_class":{"$ref":"ssw-common.v1.schema.json#/$defs/authorityClass"},
    "status":{"type":"string","enum":["PASS","REQUIRE_APPROVAL","REQUIRE_MANDATE_VALIDATION","FAIL","PROHIBITED"]},
    "reason_codes":{"$ref":"ssw-common.v1.schema.json#/$defs/reasonCodes"},
    "approval_ref":{"type":["string","null"]},
    "mandate_ref":{"type":["string","null"]},
    "evaluated_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"}
  }
}
