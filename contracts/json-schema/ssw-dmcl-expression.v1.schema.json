{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-dmcl-expression.v1.schema.json",
  "title":"SSW Deterministic Mandate Condition Language Expression v1",
  "$defs":{
    "ref":{
      "type":"object",
      "additionalProperties":false,
      "required":["ref"],
      "properties":{
        "ref":{
          "type":"string",
          "pattern":"^(action|mandate|usage|device|runtime|trust|rev|aurion|signal|evaluation)\\.[A-Za-z0-9_.-]+$"
        }
      }
    },
    "literal":{
      "type":"object",
      "additionalProperties":false,
      "required":["literal"],
      "properties":{
        "literal":{
          "type":["string","boolean"]
        },
        "type":{
          "type":"string",
          "enum":["string","boolean","integer_string","timestamp","identifier","enum"]
        }
      }
    },
    "operand":{
      "oneOf":[
        {"$ref":"#/$defs/ref"},
        {"$ref":"#/$defs/literal"}
      ]
    },
    "comparison":{
      "type":"object",
      "additionalProperties":false,
      "required":["op","left","right"],
      "properties":{
        "op":{"type":"string","enum":["eq","neq","lt","lte","gt","gte"]},
        "left":{"$ref":"#/$defs/operand"},
        "right":{"$ref":"#/$defs/operand"}
      }
    },
    "membership":{
      "type":"object",
      "additionalProperties":false,
      "required":["op","left","right"],
      "properties":{
        "op":{"type":"string","enum":["in","not_in"]},
        "left":{"$ref":"#/$defs/operand"},
        "right":{
          "type":"object",
          "additionalProperties":false,
          "required":["set"],
          "properties":{
            "set":{
              "type":"array",
              "minItems":1,
              "maxItems":256,
              "uniqueItems":true,
              "items":{"type":["string","boolean"]}
            }
          }
        }
      }
    },
    "presence":{
      "type":"object",
      "additionalProperties":false,
      "required":["op","value"],
      "properties":{
        "op":{"type":"string","enum":["exists","not_exists"]},
        "value":{"$ref":"#/$defs/ref"}
      }
    },
    "timeWindow":{
      "type":"object",
      "additionalProperties":false,
      "required":["op","value"],
      "properties":{
        "op":{"type":"string","enum":["before","after"]},
        "value":{"$ref":"#/$defs/operand"},
        "reference":{"$ref":"#/$defs/operand"}
      }
    },
    "timeOfDay":{
      "type":"object",
      "additionalProperties":false,
      "required":["op","timezone","start","end","value"],
      "properties":{
        "op":{"const":"time_of_day_between"},
        "timezone":{"type":"string","minLength":1},
        "start":{"type":"string","pattern":"^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
        "end":{"type":"string","pattern":"^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
        "value":{"$ref":"#/$defs/operand"}
      }
    },
    "booleanNode":{
      "type":"object",
      "additionalProperties":false,
      "required":["op","args"],
      "properties":{
        "op":{"type":"string","enum":["and","or"]},
        "args":{
          "type":"array",
          "minItems":1,
          "maxItems":32,
          "items":{"$ref":"#/$defs/expression"}
        }
      }
    },
    "notNode":{
      "type":"object",
      "additionalProperties":false,
      "required":["op","arg"],
      "properties":{
        "op":{"const":"not"},
        "arg":{"$ref":"#/$defs/expression"}
      }
    },
    "counter":{
      "type":"object",
      "additionalProperties":false,
      "required":["op","left","right"],
      "properties":{
        "op":{"type":"string","enum":["count_lte","cumulative_lte","frequency_lte"]},
        "left":{"$ref":"#/$defs/ref"},
        "right":{"$ref":"#/$defs/literal"}
      }
    },
    "expression":{
      "oneOf":[
        {"$ref":"#/$defs/comparison"},
        {"$ref":"#/$defs/membership"},
        {"$ref":"#/$defs/presence"},
        {"$ref":"#/$defs/timeWindow"},
        {"$ref":"#/$defs/timeOfDay"},
        {"$ref":"#/$defs/booleanNode"},
        {"$ref":"#/$defs/notNode"},
        {"$ref":"#/$defs/counter"}
      ]
    }
  },
  "$ref":"#/$defs/expression"
}
