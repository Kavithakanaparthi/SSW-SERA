{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-counterparty-resolution.v1.schema.json",
  "title":"SSW Counterparty Resolution v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","resolution_id","holder_did","original_reference",
    "status","candidates","selected","created_at","expires_at","integrity"
  ],
  "properties":{
    "schema":{"const":"ssw.counterparty-resolution.v1"},
    "resolution_id":{"type":"string","format":"uuid"},
    "holder_did":{"type":"string","pattern":"^did:soul:[a-z0-9._:-]+$"},
    "original_reference":{"type":"string","minLength":1},
    "status":{
      "type":"string",
      "enum":["UNIQUE","MULTIPLE_CANDIDATES","LOW_CONFIDENCE","UNRESOLVED","CONFLICTING_IDENTIFIERS"]
    },
    "candidates":{
      "type":"array",
      "maxItems":64,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["candidate_id","display_label","class","identifiers","provenance","confidence","verification_status"],
        "properties":{
          "candidate_id":{"type":"string","format":"uuid"},
          "display_label":{"type":"string"},
          "class":{
            "type":"string",
            "enum":["PERSON","ORGANIZATION","MERCHANT","WALLET_ADDRESS","SMART_CONTRACT","CREDENTIAL_VERIFIER","SERVICE_PROVIDER","AGENT","UNKNOWN"]
          },
          "identifiers":{
            "type":"array",
            "minItems":1,
            "items":{
              "type":"object",
              "additionalProperties":false,
              "required":["type","value"],
              "properties":{
                "type":{"type":"string","enum":["DID","AGENT_DID","CHAIN_ADDRESS","CONTRACT_ADDRESS","MERCHANT_ID","VERIFIER_ID","PROVIDER_ID"]},
                "value":{"type":"string","minLength":1},
                "chain_id":{"type":["string","null"]},
                "normalized_value":{"type":["string","null"]}
              }
            }
          },
          "provenance":{
            "type":"array",
            "minItems":1,
            "uniqueItems":true,
            "items":{
              "type":"string",
              "enum":["HOLDER_ENTERED","HOLDER_CONFIRMED","SOUL_ID_DIRECTORY","DID_RESOLUTION","PRIOR_VERIFIED_TRANSACTION","MERCHANT_DIRECTORY","WALLETCONNECT_REQUEST","CREDENTIAL_REQUEST","EXTERNAL_PROFILE","CONTRACT_REGISTRY"]
            }
          },
          "confidence":{"type":"number","minimum":0,"maximum":1},
          "verification_status":{
            "type":"string",
            "enum":["VERIFIED","UNVERIFIED","STALE","CONFLICTED","REVOKED","UNKNOWN"]
          },
          "last_verified_at":{"type":["string","null"],"format":"date-time"},
          "risk_flags":{
            "type":"array",
            "uniqueItems":true,
            "items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"}
          }
        }
      }
    },
    "selected":{
      "type":["object","null"],
      "additionalProperties":false,
      "properties":{
        "candidate_id":{"type":"string","format":"uuid"},
        "canonical_identifier_type":{"type":"string"},
        "canonical_identifier_value":{"type":"string"},
        "chain_id":{"type":["string","null"]},
        "holder_confirmation_required":{"type":"boolean"},
        "holder_confirmation_ref":{"type":["string","null"]}
      }
    },
    "created_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "integrity":{
      "type":"object",
      "additionalProperties":false,
      "required":["resolution_hash"],
      "properties":{
        "resolution_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "signature_ref":{"type":["string","null"]}
      }
    }
  }
}
