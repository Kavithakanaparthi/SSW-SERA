{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-svid4ai-agent-context.v1.schema.json",
  "title":"SSW SVID4AI Agent Context v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema","context_id","holder_did","sera_agent_did","operator_did",
    "agent","governance","delegation","trust","authority_effect",
    "observed_at","valid_until","created_at"
  ],
  "properties":{
    "schema":{"const":"ssw.svid4ai-agent-context.v1"},
    "context_id":{"type":"string","format":"uuid"},
    "holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
    "sera_agent_did":{"$ref":"ssw-common.v1.schema.json#/$defs/seraAgentDid"},
    "operator_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
    "agent":{
      "type":"object","additionalProperties":false,
      "required":["status","did_document_ref","document_version","verification_method_refs","integrity_ref"],
      "properties":{
        "status":{"const":"ACTIVE"},
        "did_document_ref":{"type":"string","minLength":1,"maxLength":2048},
        "document_version":{"type":"integer","minimum":1},
        "verification_method_refs":{"type":"array","maxItems":32,"items":{"type":"string","minLength":1,"maxLength":512},"uniqueItems":true},
        "integrity_ref":{"type":"string","minLength":1,"maxLength":2048}
      }
    },
    "governance":{
      "type":"object","additionalProperties":false,
      "required":["status","binding_ref","binding_version","governing_holder_did","operator_did"],
      "properties":{
        "status":{"const":"VERIFIED"},
        "binding_ref":{"type":"string","minLength":1,"maxLength":2048},
        "binding_version":{"type":"integer","minimum":1},
        "governing_holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
        "operator_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"}
      }
    },
    "delegation":{
      "type":"object","additionalProperties":false,
      "required":["authority_source","self_expansion_allowed","self_renewal_allowed","requires_mandate"],
      "properties":{
        "authority_source":{"const":"HOLDER_ISSUED_MANDATE"},
        "self_expansion_allowed":{"const":false},
        "self_renewal_allowed":{"const":false},
        "requires_mandate":{"const":true}
      }
    },
    "trust":{
      "type":"object","additionalProperties":false,
      "required":["trust_protocol_required_for_consequential_action","rev_required_for_consequential_action"],
      "properties":{
        "trust_protocol_required_for_consequential_action":{"const":true},
        "rev_required_for_consequential_action":{"const":true}
      }
    },
    "authority_effect":{"const":"NONE"},
    "observed_at":{"type":"string","format":"date-time"},
    "valid_until":{"type":"string","format":"date-time"},
    "created_at":{"type":"string","format":"date-time"}
  }
}