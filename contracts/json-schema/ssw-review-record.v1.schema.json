{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-review-record.v1.schema.json",
 "title":"SSW Review Record v1","type":"object","additionalProperties":false,
 "required":["schema","review_id","presentation_ref","action_id","action_version","material_terms_hash","holder_did","device_id","runtime_id","status","reviewed_at"],
 "properties":{
  "schema":{"const":"ssw.review-record.v1"},
  "review_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
  "presentation_ref":{"type":"string","minLength":1},
  "action_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
  "action_version":{"type":"integer","minimum":1},
  "material_terms_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
  "holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
  "device_id":{"$ref":"ssw-common.v1.schema.json#/$defs/deviceId"},
  "runtime_id":{"$ref":"ssw-common.v1.schema.json#/$defs/runtimeId"},
  "status":{"type":"string","enum":["REVIEWED","INVALIDATED","EXPIRED"]},
  "reviewed_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"}
 }
}