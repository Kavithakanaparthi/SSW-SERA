{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-mandate.v1.schema.json",
  "title":"SSW Delegated Authority Mandate v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","mandate_id","version","created_at","valid_from","valid_until","principal","authority","scope","limits","conditions","risk","device_policy","trust","authentication","presentation","revocation","usage","evidence","integrity"],
  "properties":{
    "schema":{"const":"ssw.mandate.v1"},
    "mandate_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "version":{"type":"integer","minimum":1},
    "created_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
    "valid_from":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
    "valid_until":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
    "principal":{
      "type":"object","additionalProperties":false,
      "required":["holder_did","sera_agent_did"],
      "properties":{
        "holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
        "sera_agent_did":{"$ref":"ssw-common.v1.schema.json#/$defs/seraAgentDid"}
      }
    },
    "authority":{
      "type":"object","additionalProperties":false,
      "required":["class","delegation_type","self_renewal_allowed"],
      "properties":{
        "class":{"type":"string","enum":["A3","A4"]},
        "delegation_type":{"type":"string","enum":["bounded","conditional"]},
        "self_renewal_allowed":{"const":false}
      }
    },
    "scope":{
      "type":"object","additionalProperties":false,
      "required":["capabilities","action_types","assets","chains","counterparties","contracts"],
      "properties":{
        "capabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "action_types":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "assets":{"type":"array","items":{"type":"object"}},
        "chains":{"type":"array","items":{"type":"object"}},
        "counterparties":{"type":"array","items":{"type":"object"}},
        "contracts":{"type":"array","items":{"type":"object"}}
      }
    },
    "limits":{"type":"object"},
    "conditions":{"type":"array","items":{"type":"object"}},
    "risk":{
      "type":"object","additionalProperties":false,
      "required":["max_class","prohibited_reasons"],
      "properties":{
        "max_class":{"$ref":"ssw-common.v1.schema.json#/$defs/riskClass"},
        "prohibited_reasons":{"$ref":"ssw-common.v1.schema.json#/$defs/reasonCodes"}
      }
    },
    "device_policy":{
      "type":"object","additionalProperties":false,
      "required":["allowed_device_ids","allowed_device_states","allowed_runtime_ids","cloud_execution_allowed","wearable_execution_allowed"],
      "properties":{
        "allowed_device_ids":{"type":"array","items":{"$ref":"ssw-common.v1.schema.json#/$defs/deviceId"},"uniqueItems":true},
        "allowed_device_states":{"type":"array","items":{"$ref":"ssw-common.v1.schema.json#/$defs/deviceTrustState"},"uniqueItems":true},
        "allowed_runtime_ids":{"type":"array","items":{"$ref":"ssw-common.v1.schema.json#/$defs/runtimeId"},"uniqueItems":true},
        "cloud_execution_allowed":{"type":"boolean"},
        "wearable_execution_allowed":{"type":"boolean"}
      }
    },
    "trust":{
      "type":"object","additionalProperties":false,
      "required":["trust_protocol_required","rev_required","aurion_required"],
      "properties":{
        "trust_protocol_required":{"type":"boolean"},
        "rev_required":{"type":"boolean"},
        "aurion_required":{"type":"boolean"}
      }
    },
    "authentication":{"type":"object"},
    "presentation":{"type":"object"},
    "revocation":{
      "type":"object","additionalProperties":false,
      "required":["status","revoked_at","revocation_reason"],
      "properties":{
        "status":{"type":"string","enum":["ACTIVE","SUSPENDED","REVOKED","EXPIRED","EXHAUSTED","TERMINATED"]},
        "revoked_at":{"type":["string","null"],"format":"date-time"},
        "revocation_reason":{"type":["string","null"]}
      }
    },
    "usage":{"type":"object"},
    "evidence":{"type":"object"},
    "integrity":{
      "type":"object","additionalProperties":false,
      "required":["mandate_terms_hash","holder_signature_ref"],
      "properties":{
        "mandate_terms_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
        "holder_signature_ref":{"type":"string","minLength":1}
      }
    }
  }
}
