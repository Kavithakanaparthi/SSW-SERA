{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-trust-protocol-decision.v1.schema.json",
 "title":"SSW Trust Protocol Decision v1",
 "type":"object","additionalProperties":false,
 "required":["schema","decision_id","request_id","action_id","action_version","material_terms_hash","status","reason_codes","principal","runtime","authority_class","risk_class","policy_version","service_identity","issued_at","expires_at","integrity"],
 "properties":{
  "schema":{"const":"ssw.trust-protocol-decision.v1"},
  "decision_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
  "request_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
  "action_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
  "action_version":{"type":"integer","minimum":1},
  "material_terms_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
  "status":{"type":"string","enum":["PASS","FAIL","UNAVAILABLE","EXPIRED"]},
  "reason_codes":{"$ref":"ssw-common.v1.schema.json#/$defs/reasonCodes"},
  "principal":{"type":"object","additionalProperties":false,"required":["holder_did","sera_agent_did"],"properties":{
   "holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
   "sera_agent_did":{"$ref":"ssw-common.v1.schema.json#/$defs/seraAgentDid"}
  }},
  "runtime":{"type":"object","additionalProperties":false,"required":["device_id","sera_runtime_id"],"properties":{
   "device_id":{"$ref":"ssw-common.v1.schema.json#/$defs/deviceId"},
   "sera_runtime_id":{"$ref":"ssw-common.v1.schema.json#/$defs/runtimeId"}
  }},
  "authority_class":{"$ref":"ssw-common.v1.schema.json#/$defs/authorityClass"},
  "risk_class":{"$ref":"ssw-common.v1.schema.json#/$defs/riskClass"},
  "policy_version":{"type":"string","minLength":1},
  "service_identity":{"type":"string","minLength":1},
  "issued_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
  "expires_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
  "integrity":{"type":"object","additionalProperties":false,"required":["decision_hash","signature_ref"],"properties":{
   "decision_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
   "signature_ref":{"type":"string","minLength":1}
  }}
 }
}