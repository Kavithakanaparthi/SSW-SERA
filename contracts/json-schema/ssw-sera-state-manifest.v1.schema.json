{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-sera-state-manifest.v1.schema.json",
 "title":"SSW SERA State Manifest v1","type":"object","additionalProperties":false,
 "required":["schema","holder_did","sera_agent_did","state_version","previous_state_cid","current_state_cid","schema_version","created_at","status","integrity"],
 "properties":{
  "schema":{"const":"ssw.sera-state-manifest.v1"},
  "holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
  "sera_agent_did":{"$ref":"ssw-common.v1.schema.json#/$defs/seraAgentDid"},
  "state_version":{"type":"integer","minimum":1},
  "previous_state_cid":{"type":["string","null"]},
  "current_state_cid":{"type":"string","minLength":1},
  "schema_version":{"type":"string","minLength":1},
  "created_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
  "status":{"type":"string","enum":["CURRENT","SUPERSEDED","REVOKED"]},
  "integrity":{"type":"object","additionalProperties":false,"required":["manifest_hash","signature_ref"],"properties":{
   "manifest_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
   "signature_ref":{"type":"string","minLength":1}
  }}
 }
}