{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-policy-decision.v1.schema.json",
  "title":"SSW Policy Decision v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","decision_id","action_id","action_version","material_terms_hash","policy_id","status","reason_codes","authority_decision_ref","risk_decision_ref","evaluated_at"],
  "properties":{
    "schema":{"const":"ssw.policy-decision.v1"},
    "decision_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "action_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "action_version":{"type":"integer","minimum":1},
    "material_terms_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
    "policy_id":{"type":"string","minLength":1},
    "status":{"type":"string","enum":["ALLOW_CONTINUE","REQUIRE_AUTHORITY","REQUIRE_DEVICE_RUNTIME","REQUIRE_TRUST_REV","DENY","PROHIBITED"]},
    "reason_codes":{"$ref":"ssw-common.v1.schema.json#/$defs/reasonCodes"},
    "authority_decision_ref":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "risk_decision_ref":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
    "evaluated_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"}
  }
}
