{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://schemas.soulverse.world/ssw/json-schema/ssw-signing-request.v1.schema.json",
 "title":"SSW Signing Request v1","type":"object","additionalProperties":false,
 "required":["schema","signing_request_id","action_id","action_version","action_contract_hash","material_terms_hash","holder_did","sera_agent_did","sera_runtime_id","device_id","authority","control_refs","payload","replay","requested_key_class","issued_at","expires_at"],
 "properties":{
  "schema":{"const":"ssw.signing-request.v1"},
  "signing_request_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
  "action_id":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
  "action_version":{"type":"integer","minimum":1},
  "action_contract_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
  "material_terms_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
  "holder_did":{"$ref":"ssw-common.v1.schema.json#/$defs/holderDid"},
  "sera_agent_did":{"$ref":"ssw-common.v1.schema.json#/$defs/seraAgentDid"},
  "sera_runtime_id":{"$ref":"ssw-common.v1.schema.json#/$defs/runtimeId"},
  "device_id":{"$ref":"ssw-common.v1.schema.json#/$defs/deviceId"},
  "authority":{"type":"object","additionalProperties":false,"required":["class","approval_ref","mandate_ref","mandate_evaluation_ref"],"properties":{
   "class":{"$ref":"ssw-common.v1.schema.json#/$defs/authorityClass"},
   "approval_ref":{"type":["string","null"]},
   "mandate_ref":{"type":["string","null"]},
   "mandate_evaluation_ref":{"type":["string","null"]}
  }},
  "control_refs":{"type":"object","additionalProperties":false,"required":["policy_ref","device_trust_ref","runtime_ref","trust_protocol_ref","rev_ref"],"properties":{
   "policy_ref":{"type":"string","minLength":1},
   "device_trust_ref":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
   "runtime_ref":{"$ref":"ssw-common.v1.schema.json#/$defs/runtimeId"},
   "trust_protocol_ref":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"},
   "rev_ref":{"$ref":"ssw-common.v1.schema.json#/$defs/uuid"}
  }},
  "payload":{"type":"object","additionalProperties":false,"required":["payload_type","payload_ref","payload_hash","body"],"properties":{
   "payload_type":{"type":"string","enum":["evm.transaction"]},
   "payload_ref":{"type":"string","minLength":1},
   "payload_hash":{"$ref":"ssw-common.v1.schema.json#/$defs/sha256"},
   "body":{"type":"object"}
  }},
  "replay":{"type":"object","additionalProperties":false,"required":["idempotency_key","replay_token","nonce"],"properties":{
   "idempotency_key":{"type":"string","minLength":1},
   "replay_token":{"type":"string","minLength":1},
   "nonce":{"type":["string","null"]}
  }},
  "requested_key_class":{"type":"string","enum":["HOLDER_EVM_ACCOUNT","HOLDER_GENERIC_SIGNING"]},
  "issued_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"},
  "expires_at":{"$ref":"ssw-common.v1.schema.json#/$defs/timestamp"}
 }
}