{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soulverse.world/ssw/json-schema/ssw-context-manifest.v1.schema.json",
  "title": "SSW Context Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "request_id",
    "holder_did",
    "sera_agent_did",
    "capability",
    "purpose",
    "model_location",
    "status",
    "items",
    "excluded",
    "created_at",
    "expires_at",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "ssw.context-manifest.v1"
    },
    "manifest_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "holder_did": {
      "type": "string",
      "pattern": "^did:soul:[a-z0-9._:-]+$"
    },
    "sera_agent_did": {
      "type": "string",
      "pattern": "^did:soul:agent:[a-z0-9._:-]+$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]+$"
    },
    "purpose": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]+$"
    },
    "model_location": {
      "type": "string",
      "enum": [
        "NONE",
        "ON_DEVICE",
        "PROTECTED_CLOUD"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "BLOCKED"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_key",
          "context_tier",
          "value",
          "source_type",
          "source_ref",
          "provenance",
          "observed_at",
          "valid_until",
          "confidence",
          "retention_class",
          "external_transmission_allowed"
        ],
        "properties": {
          "context_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]+$"
          },
          "context_tier": {
            "type": "string",
            "enum": [
              "C0",
              "C1",
              "C2",
              "C3",
              "C4"
            ]
          },
          "value": {
            "type": "object"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "WALLET_STATE",
              "MEMORY",
              "EXTERNAL",
              "SECURITY",
              "DEVICE",
              "CREDENTIAL",
              "OTHER"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "enum": [
              "HOLDER_EXPLICIT",
              "HOLDER_CORRECTION",
              "SYSTEM_OBSERVED",
              "AUTHORITATIVE_STORE",
              "EXTERNAL_IMPORTED"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "retention_class": {
            "type": "string",
            "enum": [
              "RT0",
              "RT1",
              "RT2",
              "RT3",
              "RT4",
              "RT5"
            ]
          },
          "external_transmission_allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_key",
          "reason"
        ],
        "properties": {
          "context_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]+$"
          },
          "reason": {
            "type": "string",
            "enum": [
              "NOT_ALLOWED",
              "PROHIBITED",
              "SOURCE_MISSING",
              "STALE",
              "TIER_EXCEEDED",
              "CLOUD_TRANSMISSION_DENIED",
              "FIELD_POLICY_EMPTY"
            ]
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_hash"
      ],
      "properties": {
        "manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
